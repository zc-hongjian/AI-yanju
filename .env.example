# ============================================================
# LLM（OpenAI 或任何兼容 OpenAI 的服务）
# 不填 OPENAI_API_KEY 时自动进入 offline 启发式模式，仍可跑通完整流程
# 接入步骤：填 Key → python check_llm.py 自检 → 重启 web.py
# 国内兼容服务示例（取消注释并选一组）：
#   DeepSeek : OPENAI_API_KEY=sk-xxx  OPENAI_BASE_URL=https://api.deepseek.com/v1  OPENAI_MODEL=deepseek-chat
#   通义千问 : OPENAI_API_KEY=sk-xxx  OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  OPENAI_MODEL=qwen-plus
#   智谱 GLM : OPENAI_API_KEY=xxx     OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4  OPENAI_MODEL=glm-4-flash
#   本地Ollama: OPENAI_API_KEY=ollama OPENAI_BASE_URL=http://127.0.0.1:11434/v1  OPENAI_MODEL=qwen2.5:7b
# ============================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# auto: 有 Key 用 openai，没有则 offline；也可强制 openai / offline
AGENT_LLM_MODE=auto
# 单次 LLM 请求超时（秒）：短调用（规划/校验）
AGENT_LLM_TIMEOUT=30
# 长输出调用（证据提取 / 大纲 / 报告分节）的超时（秒）。
# glm-4-flash 实测输出 750 token 就要 27~33s，用 30s 会频繁超时；
# 超时后不再做「去掉 response_format 重试」和 SDK 隐式重试，避免 30s 被放大成 120s。
AGENT_LLM_TIMEOUT_LONG=75
# 报告分节并发度（1~4）：各节只依赖“前文标题”，可并发写作；设 1 退回串行
AGENT_DRAFT_CONCURRENCY=3

# ============================================================
# 检索 / 抓取 / 重试
# ============================================================
AGENT_HTTP_TIMEOUT=10
AGENT_MAX_PAGES=3
AGENT_TOOL_MAX_ATTEMPTS=3
AGENT_RETRY_BASE_DELAY=0.5
# 单次工具调用的时间预算（秒），超过后停止重试，避免界面长时间无响应
AGENT_SEARCH_TIMEOUT=20
AGENT_FETCH_TIMEOUT=15
# 证据提取 = 一次长输出 LLM 调用，与 llm_client 的超时共用此值
AGENT_SUMMARIZE_TIMEOUT=75
# 整个节点的时间预算（秒）
AGENT_SEARCH_NODE_BUDGET=40
AGENT_FETCH_NODE_BUDGET=45
# 抓取阶段最多尝试多少个 URL（成功 3 个即止）
AGENT_FETCH_MAX_ATTEMPTS=8
# 某搜索提供方连续失败多少次后在本进程内跳过
AGENT_PROVIDER_FAILURE_LIMIT=2
# 搜索提供方顺序（逗号分隔）：bing / so360 / duckduckgo / wikipedia
# 中文宽泛问题会自动把 so360 提前（Bing 对这类问题常返回不相关结果）
AGENT_SEARCH_PROVIDERS=bing,so360,duckduckgo,wikipedia
# 乱码段落丢弃阈值：可疑字符占比超过该值即整段丢弃（0.05~0.95）
AGENT_MOJIBAKE_RATIO=0.3
# 并发抓取数：默认 3；设 1 完全退回串行（对比/排障用），夹取范围 1~6
AGENT_FETCH_CONCURRENCY=3
# 搜索/抓取结果缓存（SQLite，默认开启）：同一问题二次运行不再重复打站点
# 设 AGENT_CACHE_ENABLED=0 可完全旁路；TTL 单位秒（0 也视为关闭）
AGENT_CACHE_ENABLED=1
AGENT_CACHE_TTL=86400
AGENT_CACHE_DB=data/cache.sqlite

# ============================================================
# 写操作：邮件
# 不填 SMTP_HOST 时邮件进入 outbox/ 目录（dry-run，不真正发送）
# ============================================================
DEFAULT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# ============================================================
# 写操作：Notion
# 不填 NOTION_TOKEN 或页面/数据库 ID 时写入 outbox/notion/（dry-run）
# ============================================================
NOTION_TOKEN=
NOTION_PAGE_ID=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name
NOTION_VERSION=2022-06-28

# ============================================================
# 运行与日志
# ============================================================
AGENT_OUTBOX_DIR=outbox
AGENT_LOG_DIR=logs
# 会话持久化（SQLite）：服务重启后可从人工审批中断处恢复
AGENT_CHECKPOINT_DB=data/checkpoints.sqlite
# 会话索引库：历史会话列表 / 状态 / 父会话
AGENT_SESSIONS_DB=data/sessions.sqlite
# 节点 Span 目录（默认跟随 AGENT_LOG_DIR）
AGENT_TRACE_DIR=
# 写操作审计 + 幂等：同一运行里重复执行不会重复发邮件/重复写 Notion
# AGENT_WRITE_IDEMPOTENT=0 可关闭幂等（仍会记录审计）
AGENT_WRITE_IDEMPOTENT=1
AGENT_WRITE_AUDIT_DB=data/write_audit.sqlite

# ============================================================
# 本地知识库（RAG）
# ============================================================
AGENT_KB_DIR=knowledge
AGENT_KB_INDEX=data/kb_index.json
AGENT_KB_TOP_K=6
AGENT_KB_CHUNK_SIZE=800
AGENT_KB_OVERLAP=120
# OpenAI 兼容 /embeddings 模型名；智谱用 embedding-3；失败自动降级 BM25
AGENT_EMBEDDING_MODEL=text-embedding-3-small
# 1 = 跳过交互、自动批准草稿与两项写操作（仅用于演示/CI）
AGENT_AUTO_APPROVE=0
# 1 = 不再向终端打印每条日志
AGENT_QUIET_LOG=0

# ============================================================
# 报告与评测
# ============================================================
# 1 = 把报告里的 [S1] 角标渲染成可点击来源链接（评测消融时可设 0）
AGENT_LINK_CITATIONS=1
# 1 = plan_research 先拆解 3~5 个子问题（评测消融时可设 0）
AGENT_PLAN_SUB_QUESTIONS=1
# 报告正文字数上限（字，不含来源清单）；超过时 draft_review 记 report_too_long 并尝试压缩
AGENT_REPORT_MAX_CHARS=1000
# 证据召回兜底：LLM 从某些来源一条都没提取时，用启发式摘录原句补齐（0=关闭）
AGENT_EVIDENCE_SUPPLEMENT=1
# 单页兜底条数 / 总兜底条数上限（质量门：语言对齐 + 至少命中 2 个问题关键词）
AGENT_EVIDENCE_SUPPLEMENT_PER_SOURCE=2
AGENT_EVIDENCE_SUPPLEMENT_MAX=2
# 1 = 草稿引用/结构校验（含对比表格、篇幅、重复事实）
AGENT_DRAFT_REVIEW=1
# token 成本单价（元 / 百万 token），用于 final_output.cost_cny
AGENT_PRICE_INPUT_PER_MTOK=1.0
AGENT_PRICE_OUTPUT_PER_MTOK=4.0
